{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent",
  "type": "object",
  "required": [
    "id",
    "name",
    "email",
    "join_date",
    "months_active",
    "guarantee_active"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "join_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "months_active": {
      "type": "integer",
      "minimum": 0
    },
    "guarantee_active": {
      "type": "boolean"
    }
  }
}
